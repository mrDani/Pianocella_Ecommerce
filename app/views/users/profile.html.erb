<h1>My Profile</h1>

<div class="card p-3">
  <p><strong>Username:</strong> <%= @user.username %></p>
  <p><strong>Email:</strong> <%= @user.email %></p>
  <p><strong>Address:</strong> <%= @user.address %></p>
  <p><strong>City:</strong> <%= @user.city %></p>
  <p><strong>Province:</strong> <%= current_user.province.name if current_user.province %></p>
  <p><strong>Postal Code:</strong> <%= @user.postal_code %></p>
</div>

<h2>Edit Shipping Info</h2>
<%= form_with(model: current_user, url: update_shipping_path, method: :patch, local: true) do |f| %>
  <%= f.label :address %>
  <%= f.text_field :address, class: "form-control" %>

  <%= f.label :city %>
  <%= f.text_field :city, class: "form-control" %>

  <%= f.label :postal_code %>
  <%= f.text_field :postal_code, class: "form-control" %>

  <%= f.label :province_id, "Province" %>
  <%= f.collection_select :province_id, Province.all, :id, :name, {}, class: "form-control" %>

  <%= f.submit "Update Address", class: "btn btn-primary mt-3" %>
<% end %>

